      { name: "Blue Nile", slug: "blue_nile", cells: {"1ct": {status:"thin", stone_count:18, note:"Below the 30-listing minimum, as in July (n=18 both months): genuinely thin E VS1 IGI inventory, not a collection issue."}, "1.5ct": {status:"thin", stone_count:5, note:"Below the 30-listing minimum this edition; a larger share of Blue Nile's E-color inventory now carries GCAL or GIA reports rather than IGI, not a collection issue."}, "2ct": {status:"thin", stone_count:27, note:"Below the 30-listing minimum this edition; a larger share of Blue Nile's E-color inventory now carries GCAL or GIA reports rather than IGI, not a collection issue."}} },
