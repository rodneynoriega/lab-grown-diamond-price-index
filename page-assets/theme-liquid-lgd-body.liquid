      { name: "Clean Origin", slug: "clean_origin", cells: {"1ct": {status:"thin", stone_count:1, note:"Below the 30-listing minimum this edition; Clean Origin's listed E-color inventory contracted sharply, see Coverage this edition."}, "1.5ct": {status:"thin", stone_count:24, note:"Below the 30-listing minimum this edition; see Coverage this edition."}, "2ct": {status:"ok", stone_count:187, median_price_per_carat:278}} },
      { name: "Grown Brilliance", slug: "grown_brilliance", cells: {"1ct": {status:"ok", stone_count:795, median_price_per_carat:500, note:"Published again after July's single-stone cell; collection returned 61,542 listings this month against 4,141 in July. See Coverage this edition."}, "1.5ct": {status:"ok", stone_count:371, median_price_per_carat:648}, "2ct": {status:"ok", stone_count:920, median_price_per_carat:659}} },
