{# Shared macros + inline design system for all pilot pages, matching the
   US index block's visual language (page-assets/us-index-gempages-
   2026-08-09-retitle.html). Inline styles only: pilot pages render
   through the theme's default page template. Scope rules live here so
   every page carries them: brand line (the ONLY place "Price Index"
   appears), honest delist-window labels, pooled-vs-benchmark stat
   distinction, loose-stone / no-ring-total statement, affirmative
   disclosure. Deliberately NOT reproduced: the index block's
   "Rings.com | Research & Data" mini-nav strip (the theme header
   already provides nav; duplicating it is the annoyance to avoid). #}

{% set container = "max-width:860px;margin:0 auto;padding:0 16px 24px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1a1a1a;" %}
{% set h2s = "font-size:1.15rem;font-weight:700;margin:28px 0 12px;color:#1a1a1a;" %}
{% set body_p = "margin:0 0 12px;line-height:1.6;" %}
{# 0.8rem footnote class is italic (Rodney 2026-08-10): size alone did not read as a distinction #}
{% set note = "font-size:0.8rem;font-style:italic;color:#666;line-height:1.6;margin:0 0 12px;" %}
{# width:0 + min-width:100% keeps the wrapper's min-content contribution at
   zero: the theme's page column is a flex/grid item, and without this a wide
   table's min-content width propagates up and drags the whole column wider
   than a phone viewport (reproduced + fixed at 390px, 2026-08-10). #}
{% set wrap = "overflow-x:auto;margin-bottom:24px;width:0;min-width:100%;" %}
{% set table = "width:100%;border-collapse:collapse;font-size:0.95rem;" %}
{% set th_l = "text-align:left;padding:10px 12px;border-bottom:2px solid #1a1a1a;font-weight:700;color:#1a1a1a;background:#fff;" %}
{% set th_r = "text-align:right;padding:10px 12px;border-bottom:2px solid #1a1a1a;font-weight:700;color:#1a1a1a;background:#fff;" %}
{% set callout = "background:#1a1a1a;color:#fff;border-radius:6px;padding:20px 24px;margin:0 0 24px;" %}
{% set callout_p = "margin:0;font-size:1.05rem;font-weight:700;line-height:1.5;color:#fff;" %}
{% set callout_2 = "margin:8px 0 0;color:#c8c8c8;font-size:0.9rem;line-height:1.6;" %}
{% set absent = "color:#aaa;" %}
{# Obvious, tappable links (2026-10-10, Rodney: "make the links more obvious and clickable"). The theme strips link colour and underline, so everything is inline. Row = full-width tap target (>=44px), blue, underlined, arrow. #}
{% set link_list = "list-style:none;margin:0 0 16px;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px;" %}
{% set link_row = "display:block;padding:12px 14px;min-height:20px;border:1px solid #c9d6f2;border-radius:6px;background:#f6f9ff;color:#1a56db;font-weight:600;line-height:1.4;text-decoration:underline;text-underline-offset:3px;" %}
{% set link_inline = "color:#1a56db;font-weight:600;text-decoration:underline;text-underline-offset:3px;" %}

{% macro td(bg) %}padding:10px 12px;background:{{ bg }};{% endmacro %}
{% macro tdn(bg) %}text-align:right;padding:10px 12px;background:{{ bg }};font-variant-numeric:tabular-nums;{% endmacro %}

{# Header, reference-style (Rodney's US-index screenshots, 2026-08-10):
   masthead strip, thick rule, kicker, in-body H1, brand-line subtitle,
   middot meta line. The first <style> hides the Flex theme's hardcoded
   page-title block (.heading-wrapper--page wraps the injected
   <h1 class="page__title"> AND its divider; markup verified live via
   /pages/about-us?view=lgd-research, 2026-08-10). The theme H1 stays in
   the DOM (display:none); this macro's h1 is the visible heading. Page
   <style> tags only affect the page they are on, so the hide cannot leak
   to other pages. Literal UTF-8 (· &), never entities: Shopify decodes
   entities on store and that breaks body-equality verification. #}
{# Citability additions (2026-09-03): optional `answer` renders as the first
   sentence under the H1; a plain-text "as of" line and methodology /
   retailer-selection / about-this-data links sit in the first screen so a
   model quoting the page gets the number, the date, the retailer count and
   the provenance links before anything else. #}
{% macro header(h1, index_url, brand_line, cycle_label, data_date_h, published_h=None, answer=None, next_update_h=None) %}
<style>.heading-wrapper--page{display:none;}
.lgd-pilot h1{font-size:clamp(1.55rem,6vw,2.1rem)!important;}
.lgd-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:0 0 20px}
@media (max-width:640px){.lgd-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
.lgd-stat{border:1px solid #e5e5e5;border-radius:6px;padding:12px 14px;min-width:0}
.lgd-stat b{display:block;font-size:1.3rem;font-weight:700;letter-spacing:-0.01em;line-height:1.2;color:#1a1a1a;font-variant-numeric:tabular-nums}
.lgd-stat span{display:block;font-size:0.72rem;color:#777;margin-top:4px;line-height:1.35}
details.lgd-fold{border-top:1px solid #e8e8e8;border-bottom:1px solid #e8e8e8;padding:9px 0;margin:0 0 22px}
details.lgd-fold summary{cursor:pointer;font-weight:600;font-size:0.92rem;line-height:1.45;list-style:none;position:relative;padding-right:24px;color:#1a1a1a}
details.lgd-fold summary::-webkit-details-marker{display:none}
details.lgd-fold summary::after{content:"+";position:absolute;right:2px;top:0;color:#999;font-weight:400}
details.lgd-fold[open] summary::after{content:"\2212"}
.lgd-meta{font-size:0.82rem;color:#555;line-height:1.6;margin:0 0 6px}
.lgd-meta a{color:#1a1a1a;font-weight:600;text-decoration:underline;text-underline-offset:2px;white-space:nowrap}
</style>
<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:4px 16px;padding-bottom:10px;border-bottom:1px solid #e5e5e5;margin-bottom:20px;">
  <span style="font-size:1rem;font-weight:600;letter-spacing:0.16em;color:#1a1a1a;">RINGS.COM</span>
  <span style="font-size:0.72rem;font-weight:600;letter-spacing:0.14em;color:#999;">RESEARCH & DATA</span>
</div>
<div style="border-top:3px solid #1a1a1a;padding-top:16px;margin-bottom:28px;">
  <p style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#888;margin:0 0 10px;">Rings.com Research</p>
  <h1 style="font-size:2.1rem;font-weight:700;line-height:1.15;margin:0 0 12px;color:#1a1a1a;">{{ h1 }}</h1>
  {% if answer %}
  <p class="lgd-answer" style="margin:0 0 10px;color:#1a1a1a;font-size:1rem;font-weight:600;line-height:1.5;max-width:640px;">{{ answer }}</p>
  {% endif %}
  <p class="lgd-brand-line" style="margin:0 0 8px;color:#555;font-size:0.85rem;line-height:1.55;">{{ brand_line }}: <a href="{{ index_url }}" style="color:#1a1a1a;font-weight:600;text-decoration:underline;text-underline-offset:2px;">Lab Grown Diamond Price Per Carat</a>.</p>
  <p class="lgd-method-links lgd-meta" style="margin-bottom:12px;"><a href="{{ index_url }}#methodology">How the Price Index is calculated</a> · <a href="/pages/retailer-inclusion-criteria">Which retailers are included and why</a> · <a href="#lgd-about-data">About this page's data</a></p>
  <p class="lgd-asof" style="margin:0;padding-top:10px;border-top:1px solid #ebebeb;font-size:0.78rem;color:#999;line-height:1.6;">Data as of {{ cycle_label }}, captured {{ data_date_h }}{% if published_h %}, published {{ published_h }}{% endif %}. Updated monthly{% if next_update_h %}, next update {{ next_update_h }}{% endif %}. USD.</p>
</div>
{% endmacro %}

{# Email capture: Klaviyo list Xi8xP8 (Rodney, 2026-08-10; deliberately NOT
   the contact page's VXECZW list). Same mechanism and copy as the live
   rings.com contact page's signup box, replicated inline so pilot pages
   have no theme/app dependency. Client-side subscribe via Klaviyo's public
   kmail-lists endpoint, identical to the contact page's pattern. #}
{% macro email_capture(track=False) %}
<div class="lgd-email-capture" style="border:1px solid #ddd;border-radius:6px;padding:20px 24px;margin:32px 0 0;">
  <{{ "p" if track else "h2" }} style="font-size:1.05rem;font-weight:700;margin:0 0 6px;color:#1a1a1a;">Get future Rings.com Research in your inbox</{{ "p" if track else "h2" }}>
  <p style="margin:0 0 14px;font-size:0.9rem;color:#555;line-height:1.6;">New studies and data delivered when they publish. No other emails.</p>
  <div style="display:flex;flex-wrap:wrap;gap:10px;">
    <input type="email" id="lgd-klav-email" placeholder="your@email.com" aria-label="Email address" style="flex:1 1 200px;min-width:0;padding:10px 14px;font-size:0.9rem;border:1px solid #d0d0d0;border-radius:4px;outline:none;font-family:inherit;color:#1a1a1a;background:#fff;">
    <button onclick="lgdKlavSubscribe(event)" style="padding:10px 22px;font-size:0.875rem;font-weight:600;background:#1a1a1a;color:#fff;border:none;border-radius:4px;cursor:pointer;font-family:inherit;">Subscribe</button>
  </div>
  <p id="lgd-klav-confirm" style="display:none;font-size:0.875rem;color:#2e7d32;margin:10px 0 0;">You're on the list.</p>
  <p id="lgd-klav-error" style="display:none;font-size:0.875rem;color:#c62828;margin:10px 0 0;">Something went wrong. Please try again.</p>
</div>
<script>
function lgdKlavSubscribe(e) {
  e.preventDefault();
  var email = document.getElementById('lgd-klav-email').value;
  var confirm = document.getElementById('lgd-klav-confirm');
  var error = document.getElementById('lgd-klav-error');
  confirm.style.display = 'none';
  error.style.display = 'none';
  fetch('https://manage.kmail-lists.com/ajax/subscriptions/subscribe', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=utf-8' },
    body: 'g=Xi8xP8&email=' + encodeURIComponent(email)
  })
  .then(function(r) { return r.json(); })
  .then(function(j) {
    if (j.success) {
      confirm.style.display = 'block';{{ (" if (window.lgdTrackSignup) { lgdTrackSignup('lgd_email_signup', 'top'); }" | safe) if track else "" }}
      document.getElementById('lgd-klav-email').value = '';
    } else {
      error.style.display = 'block';
    }
  })
  .catch(function() {
    error.style.display = 'block';
  });
}
</script>
{% endmacro %}

{# Signup placement (2026-10-05): on EVERY aggregate page (not stone pages)
   the existing email_capture block is rendered near the top (track=True) and
   footer() omits the bottom copy. Stone pages keep the bottom block. lgdTrackSignup publishes a Shopify customer event
   (needs a custom pixel to reach GA4; harmless without one). #}
{% macro track_script() %}
<script>
function lgdTrackSignup(eventName, block) {
  try {
    if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) {
      Shopify.analytics.publish(eventName, { block: block, page: location.pathname });
    }
  } catch (err) {}
}
</script>
{% endmacro %}

{# CTA test 2 (2026-10-05, oval page only, DRAFT, NOT approved for publish):
   Buy or Pass early-access list. Klaviyo list YnKGb6 (created 2026-10-05).
   No money, no live service, no price. Email only: a cert-number field was
   dropped because extra subscribe parameters are unverified and a failed
   request would silently lose signups. HELD OFF: allowed only on the Index
   (theme script twin) and the comparison hub, and only after Amendment 1 to the
   accepted-risk memo is signed and a gate report authorizes it. #}
{% macro buy_or_pass_waitlist(top=False) %}
<div class="lgd-buy-or-pass" style="border:1px solid #ddd;border-radius:6px;padding:20px 24px;margin:28px 0 0;">
  <{{ "p" if top else "h2" }} style="font-size:1.05rem;font-weight:700;margin:0 0 6px;color:#1a1a1a;">Buy or Pass: a second opinion on one stone (early access)</{{ "p" if top else "h2" }}>
  <p style="margin:0 0 12px;font-size:0.9rem;color:#555;line-height:1.6;">Found a lab grown diamond and not sure the price is fair? We are planning a short written price check. Send the certificate number and the asking price, and get back where that price sits against our published data, a Buy, Pass or Negotiate verdict with a fair price range, and three questions to ask the seller. Planned price: $79, reply within 2 business days. Join the early-access list and we will email you when it opens. No payment is taken now.</p>
  <form id="lgd-bop-form" onsubmit="lgdBopSubscribe(event)" style="display:flex;flex-wrap:wrap;gap:10px;margin:0;">
    <input type="email" id="lgd-bop-email" required autocomplete="email" placeholder="your@email.com" aria-label="Email address for early access" style="flex:1 1 200px;min-width:0;min-height:44px;box-sizing:border-box;padding:10px 14px;font-size:0.9rem;border:1px solid #d0d0d0;border-radius:4px;outline:none;font-family:inherit;color:#1a1a1a;background:#fff;">
    <button type="submit" id="lgd-bop-btn" style="min-height:44px;box-sizing:border-box;padding:10px 22px;font-size:0.875rem;font-weight:600;background:#1a1a1a;color:#fff;border:none;border-radius:4px;cursor:pointer;font-family:inherit;">Join early access</button>
  </form>
  <p id="lgd-bop-confirm" style="display:none;font-size:0.875rem;color:#2e7d32;margin:10px 0 0;">You're on the early-access list.</p>
  <p id="lgd-bop-error" style="display:none;font-size:0.875rem;color:#c62828;margin:10px 0 0;">Something went wrong. Please try again.</p>
  <p style="margin:12px 0 0;font-size:0.78rem;color:#666;line-height:1.55;">We will only use your email to tell you about this service. A price comparison, not an appraisal, grading report, insurance value or guarantee, and it would not recommend a retailer. It would be a paid service: you pay Rings.com, retailers do not. Rings.com receives no compensation from the retailers included for inclusion or ranking.</p>
</div>
<script>
function lgdBopSubscribe(e) {
  e.preventDefault();
  var email = document.getElementById('lgd-bop-email');
  var btn = document.getElementById('lgd-bop-btn');
  var okMsg = document.getElementById('lgd-bop-confirm');
  var errMsg = document.getElementById('lgd-bop-error');
  okMsg.style.display = 'none';
  errMsg.style.display = 'none';
  if (!email.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) { errMsg.style.display = 'block'; return; }
  btn.disabled = true;
  fetch('https://manage.kmail-lists.com/ajax/subscriptions/subscribe', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=utf-8' },
    body: 'g=YnKGb6&email=' + encodeURIComponent(email.value)
  })
  .then(function(r) { return r.json(); })
  .then(function(j) {
    if (j.success) {
      okMsg.style.display = 'block';
      if (window.lgdTrackSignup) { lgdTrackSignup('lgd_buy_or_pass_waitlist', 'hub-page'); }
      email.value = '';
    } else {
      errMsg.style.display = 'block';
    }
    btn.disabled = false;
  })
  .catch(function() {
    errMsg.style.display = 'block';
    btn.disabled = false;
  });
}
</script>
{% endmacro %}

{# Related-links block (v6): internal links so the cluster is crawlable
   through itself, not just the sitemap. The pipeline only passes links
   to pages that actually built this run. #}
{# styled=True (October 2026 refresh, 14 of 18 aggregates): blue tappable rows, same variables as the hub's link lists. Default False keeps the plain list (held pages, stone pages). #}
{% macro related(items, styled=False) %}
{% if items and styled %}
<div style="border-top:1px solid #ddd;margin-top:28px;padding-top:16px;">
<h2 style="font-size:1rem;font-weight:700;margin:0 0 12px;color:#1a1a1a;">More lab grown diamond price data</h2>
<ul style="{{ link_list }}">
{% for label, href in items %}
  <li style="margin:0;"><a href="{{ href }}" style="{{ link_row }}">{{ label }} <span aria-hidden="true">&rarr;</span></a></li>
{% endfor %}
</ul>
</div>
{% elif items %}
<div style="border-top:1px solid #ddd;margin-top:28px;padding-top:16px;">
<h2 style="font-size:1rem;font-weight:700;margin:0 0 12px;color:#1a1a1a;">More lab grown diamond price data</h2>
<ul style="margin:0;padding-left:18px;">
{% for label, href in items %}
  <li style="font-size:0.9rem;line-height:1.9;"><a href="{{ href }}" style="color:#1a1a1a;font-weight:600;text-decoration:underline;text-underline-offset:2px;">{{ label }}</a></li>
{% endfor %}
</ul>
</div>
{% endif %}
{% endmacro %}

{# Stone links (October 2026 refresh, 14 of 18 aggregates). `blk` is built by page_pipeline.stone_link_block: {"intro", "groups": [{"heading", "rows": [{"href","label","sub"}]}]}. Falsy blk renders nothing (a page with fewer than 3 live stones in range gets no block). Rows are blue tappable rows like the hub; the sub line is a non-link detail. #}
{% macro stone_links(blk, data_date_h) %}
{% if blk %}
<div class="lgd-stone-links" style="margin:28px 0 8px;">
<h2 style="{{ h2s }}">{{ blk.heading }}</h2>
<p style="{{ body_p }}">{{ blk.intro }}</p>
{% for g in blk.groups %}
{% if g.heading %}<p style="margin:0 0 8px;font-weight:700;line-height:1.4;">{{ g.heading }}</p>{% endif %}
{% if g.note %}<p style="{{ body_p }}">{{ g.note }}</p>{% endif %}
<ul style="{{ link_list }}">
{% for r in g.rows %}
  <li style="margin:0;"><a href="{{ r.href }}" style="{{ link_row }}">{{ r.label }} <span aria-hidden="true">&rarr;</span><br><span style="display:inline-block;font-size:0.82rem;font-weight:400;color:#444;margin-top:2px;text-decoration:none;">{{ r.sub }}</span></a></li>
{% endfor %}
</ul>
{% endfor %}
<p style="{{ note }}">Listed prices as of {{ data_date_h }}, not quotes; a stone may have sold or been repriced since. Loose stones only. This is not a recommendation of any retailer.</p>
</div>
{% endif %}
{% endmacro %}

{% macro footer(no_capture=False) %}
{{ "" if no_capture else email_capture() }}
<div style="margin-top:24px;padding-top:12px;border-top:1px solid #eee;">
  <p style="margin:0 0 4px;font-size:0.8rem;color:#888;">Updated monthly.</p>
  <p style="margin:0;font-size:0.78rem;color:#999;">Rings.com Lab-Grown Diamond Price Index</p>
</div>
{% endmacro %}

{% macro delist_note(data_date_h, retailers, cycle_label="July 2026", last_label=None, last_date_h=None) %}
<div style="border-top:1px solid #ddd;margin-top:28px;padding-top:16px;">
<h2 style="font-size:1rem;font-weight:700;margin:0 0 12px;color:#1a1a1a;">How current are these prices?</h2>
{% if last_label %}
<p style="margin:0 0 12px;font-size:0.9rem;color:#333;line-height:1.7;">The prices in the table above were last captured from public retailer listings on <strong>{{ last_date_h }}</strong> ({{ last_label }} collection cycle). In the <strong>{{ data_date_h }}</strong> ({{ cycle_label }}) collection this certificate was not found at two or more tracked retailers, so no current comparison is shown. Retailers reprice and delist stones continuously, so any listing shown here may have sold, been delisted, or changed price since capture.</p>
{% else %}
<p style="margin:0 0 12px;font-size:0.9rem;color:#333;line-height:1.7;">Every price on this page was captured from public retailer listings on <strong>{{ data_date_h }}</strong> ({{ cycle_label }} collection cycle) and is accurate as of that date only. Retailers reprice and delist stones continuously, so any listing shown here may have sold, been delisted, or changed price since capture.</p>
{% endif %}
<ul style="margin:0 0 12px;padding-left:18px;">
{% for r in retailers %}
  <li style="font-size:0.9rem;color:#333;line-height:1.7;"><strong>{{ r }}</strong>: last verified in its public listings on {{ data_date_h }}. Re-checked on the index's collection cycle (currently monthly; weekly refresh rolling out).</li>
{% endfor %}
</ul>
</div>
{% endmacro %}

{% macro loose_stone_note() %}
<p style="font-size:0.8rem;font-style:italic;color:#666;line-height:1.6;margin:0 0 12px;"><strong>Loose stones only.</strong> Every figure on this page is for a loose lab grown diamond as listed, before any ring setting. No blended ring-total pricing appears on this page; setting costs vary by retailer and are never merged into these comparisons.</p>
{% endmacro %}

{% macro stat_distinction() %}
<p class="lgd-stat-def" style="font-size:0.8rem;font-style:italic;color:#666;line-height:1.6;margin:0 0 12px;"><strong>Stat definition.</strong> Figures on this page pool all qualifying listings in the stated carat range: all colors, clarities, and cut grades, from retailers with at least 30 qualifying listings. The monthly Index benchmark is a different, tighter statistic (E VS1 round Excellent-cut IGI). The two are not comparable and should not be quoted against each other.</p>
{% endmacro %}

{# Quotable facts (2026-09-03): 3-5 standalone one-sentence facts, each with
   a number and the cycle date, computed in page_pipeline.py from the same
   stats as the tables. Plain text, no markup, so a model can lift verbatim. #}
{% macro facts(items, cycle_label) %}
{% if items %}
<details class="lgd-facts-wrap lgd-fold">
  <summary>Key figures in words, {{ cycle_label }} (for quoting)</summary>
  <ul class="lgd-facts-list" style="margin:8px 0 0;padding-left:18px;font-size:0.9rem;line-height:1.6;color:#333;">
  {% for f in items %}
    <li style="margin:0 0 8px;">{{ f }}</li>
  {% endfor %}
  </ul>
</details>
{% endif %}
{% endmacro %}

{# Stat strip (2026-09-03 redesign): four numbers with small labels, two per
   row on phones; the same values as the page's tables. #}
{% macro tiles(items) %}
{% if items %}
<div class="lgd-stats">
  {% for v, l in items %}
  <div class="lgd-stat"><b>{{ v }}</b><span>{{ l }}</span></div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro methodology(data_date_h) %}
<div id="lgd-about-data" style="border-top:1px solid #ddd;margin-top:28px;padding-top:16px;">
<h2 style="font-size:1rem;font-weight:700;margin:0 0 12px;color:#1a1a1a;">About this data</h2>
<p style="margin:0;font-size:0.9rem;color:#333;line-height:1.7;">Prices are publicly listed retail prices for loose lab grown diamonds, collected from each retailer's public website on {{ data_date_h }}. No accounts, logins, or paywalls are involved; these are the prices any shopper sees. Rings.com is an independent research publisher, not a jewelry retailer, and publishes this data as an attributed, dated record of public listing prices. Retailer names are used for identification only; Rings.com is not affiliated with any retailer listed.</p>
</div>
{% endmacro %}
